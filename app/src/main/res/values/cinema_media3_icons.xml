<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Intentional, narrowly scoped overrides of the documented Media3 resources.
         tools:override acknowledges the deliberate replacement, not a blanket lint ignore.
         Documented Media3 drawable overrides keep its controller logic, labels and targets.
         https://developer.android.com/reference/androidx/media3/ui/PlayerControlView -->
    <item name="exo_styled_controls_play" type="drawable" tools:override="true">@drawable/cinema_v3_play_default</item>
    <item name="exo_styled_controls_pause" type="drawable" tools:override="true">@drawable/cinema_v3_pause_default</item>
</resources>
